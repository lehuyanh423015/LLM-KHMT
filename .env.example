# Local LLM Provider Configuration
LLM_PROVIDER=ollama

# Ollama Endpoint Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Operation Modes
LLM_MODE=fast
OLLAMA_FAST_MODEL=qwen2.5:0.5b
OLLAMA_QUALITY_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=320
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=90

# Feature Experiments toggles
ENABLE_MEMORY=true
ENABLE_RECENT_CONTEXT=true
ENABLE_PRODUCT_CONTEXT=false
ENABLE_GROUNDED_PRODUCT_ANSWER=true
RECENT_CONTEXT_LIMIT=6
ENABLE_WEB_SEARCH=true
WEB_SEARCH_RESULTS=5
ENABLE_EXTERNAL_PRODUCT_SEARCH=true
EXTERNAL_PRODUCT_SEARCH_RESULTS=3

# Chroma persistence directory
CHROMA_PERSIST_DIR=./chroma_data
