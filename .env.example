# Local LLM Provider Configuration
LLM_PROVIDER=ollama

# Ollama Endpoint Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Single Ollama model used for final answer synthesis
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=90

# Feature Experiments toggles
ENABLE_MEMORY=true
ENABLE_RECENT_CONTEXT=true
ENABLE_PRODUCT_CONTEXT=true
# true = deterministic retrieval/template answer from the internal catalog.
# This is the stable demo mode. Set false only when testing LLM synthesis.
ENABLE_GROUNDED_PRODUCT_ANSWER=true
RECENT_CONTEXT_LIMIT=6
ENABLE_WEB_SEARCH=false
WEB_SEARCH_RESULTS=5
ENABLE_EXTERNAL_PRODUCT_SEARCH=false
EXTERNAL_PRODUCT_SEARCH_RESULTS=3

# Chroma persistence directory
CHROMA_PERSIST_DIR=./chroma_data
